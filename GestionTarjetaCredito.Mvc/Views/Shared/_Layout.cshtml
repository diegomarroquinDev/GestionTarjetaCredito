<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Tarjeta Credito</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    <header class="top-navbar">
        <div class="container-fluid px-4">

            <nav class="navbar navbar-expand-lg navbar-light">

                <a class="navbar-brand brand-atlantida"
                   asp-controller="CreditCards"
                   asp-action="Statement"
                   asp-route-id="1">

                    <span class="brand-symbol">▲</span>
                    <span class="brand-text">B. Atl</span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Mostrar navegación">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">

                        <li class="nav-item">
                            <a class="nav-link modern-nav-link"
                               asp-controller="CreditCards"
                               asp-action="Statement"
                               asp-route-id="1">
                                Estado de cuenta
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link modern-nav-link"
                               asp-controller="CreditCards"
                               asp-action="CreatePurchase"
                               asp-route-id="1">
                                Compras
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link modern-nav-link"
                               asp-controller="CreditCards"
                               asp-action="CreatePayment"
                               asp-route-id="1">
                                Pagos
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link modern-nav-link"
                               asp-controller="CreditCards"
                               asp-action="Transactions"
                               asp-route-id="1">
                                Movimientos
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link modern-nav-link"
                               asp-controller="CreditCards"
                               asp-action="Configurations">
                                Configuración
                            </a>
                        </li>

                    </ul>

                </div>

            </nav>

        </div>
    </header>

    <div class="container">
        <main role="main" class="pb-3">

            @RenderBody()

        </main>
    </div>

    <footer class="border-top footer text-muted atlantida-footer">
        <div class="container">
            &copy; 2026 - Gestión de Tarjeta de Crédito
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>