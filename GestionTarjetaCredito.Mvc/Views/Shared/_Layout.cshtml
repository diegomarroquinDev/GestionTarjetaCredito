<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Banco Atlántida</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm atlantida-navbar mb-4">
            <div class="container">

                <a class="navbar-brand atlantida-brand"
                   asp-controller="CreditCards"
                   asp-action="Statement"
                   asp-route-id="1">

                    <span class="atlantida-brand-mark">▲</span>
                    Banco Atlántida

                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-end">

                    <ul class="navbar-nav">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="CreditCards"
                               asp-action="Statement"
                               asp-route-id="1">
                                Estado de cuenta
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                Compras
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                Pagos
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="CreditCards"
                               asp-action="Transactions"
                               asp-route-id="1">
                                Movimientos
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                Configuración
                            </a>
                        </li>

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">

            @RenderBody()

        </main>
    </div>

    <footer class="border-top footer text-muted atlantida-footer">
        <div class="container">
            &copy; 2026 - Gestión de Tarjeta de Crédito
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>