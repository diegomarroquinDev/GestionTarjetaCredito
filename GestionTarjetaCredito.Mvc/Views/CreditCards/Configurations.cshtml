@model IEnumerable<GestionTarjetaCredito.Mvc.Models.FinancialConfigurationViewModel>

@{
    ViewData["Title"] = "Configuración financiera";
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="page-title">Configuración financiera</h2>

        <p class="page-subtitle">
            Administra los parámetros utilizados para los cálculos de la tarjeta.
        </p>
    </div>

    @if (TempData["SuccessMessage"] is not null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>
        </div>
    }

    @if (TempData["ErrorMessage"] is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Cerrar">
            </button>
        </div>
    }

    <div class="card financial-panel">

        <div class="card-body p-4">

            <div class="table-responsive">

                <table class="table align-middle">

                    <thead>
                        <tr>
                            <th>Configuración</th>
                            <th>Descripción</th>
                            <th style="width: 220px;">
                                Valor
                            </th>
                            <th style="width: 150px;">
                                Acción
                            </th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var configuration in Model)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @configuration.Code
                                    </strong>
                                </td>

                                <td>
                                    @configuration.Description
                                </td>

                                <td>

                                    <form asp-action="UpdateConfiguration"
                                          method="post"
                                          class="d-flex gap-2 align-items-center">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="Id"
                                               value="@configuration.Id" />

                                        <input type="hidden"
                                               name="Code"
                                               value="@configuration.Code" />

                                        <input type="hidden"
                                               name="Description"
                                               value="@configuration.Description" />

                                        <div class="input-group">

                                            <input type="number"
                                                   name="Value"
                                                   value="@configuration.Value"
                                                   step="0.01"
                                                   min="0"
                                                   max="100"
                                                   class="form-control" />

                                            <span class="input-group-text">
                                                %
                                            </span>

                                        </div>

                                        <button type="submit"
                                                class="btn btn-atlantida">
                                            Guardar
                                        </button>

                                    </form>

                                </td>

                                <td>
                                    @if (configuration.UpdatedDate.HasValue)
                                    {
                                        <small class="text-muted">
                                            @configuration.UpdatedDate.Value
                                            .ToString("dd/MM/yyyy HH:mm")
                                        </small>
                                    }
                                    else
                                    {
                                        <small class="text-muted">
                                            Sin cambios
                                        </small>
                                    }
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>