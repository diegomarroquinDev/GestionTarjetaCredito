@model GestionTarjetaCredito.Mvc.Models.CreatePurchaseViewModel

@{
    ViewData["Title"] = "Registrar compra";
}

<div class="container py-4 purchase-page">

    <div class="purchase-header mb-4">
        <span class="purchase-eyebrow">
            Operaciones
        </span>

        <h2 class="purchase-title">
            Registrar compra
        </h2>

        <p class="purchase-subtitle">
            Registra una nueva compra asociada a la tarjeta de crédito.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-lg-8">

            <div class="purchase-card">

                <div class="purchase-card-header">
                    <div>
                        <h5 class="mb-1">
                            Datos de la compra
                        </h5>

                        <p class="mb-0">
                            Ingresa la información de la transacción.
                        </p>
                    </div>

                    <div class="purchase-card-icon">
                        $
                    </div>
                </div>

                <div class="purchase-card-body">

                    <form asp-action="CreatePurchase"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input asp-for="CreditCardId"
                               type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger validation-summary"
                             role="alert">
                        </div>

                        <div class="mb-4">

                            <label asp-for="TransactionDate"
                                   class="form-label purchase-label">
                                Fecha de compra
                            </label>

                            <div class="purchase-input-wrapper">

                                <span class="purchase-input-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg"
                                         width="18"
                                         height="18"
                                         viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="2"
                                         stroke-linecap="round"
                                         stroke-linejoin="round">

                                        <rect x="3"
                                              y="4"
                                              width="18"
                                              height="18"
                                              rx="2">
                                        </rect>

                                        <line x1="16"
                                              y1="2"
                                              x2="16"
                                              y2="6">
                                        </line>

                                        <line x1="8"
                                              y1="2"
                                              x2="8"
                                              y2="6">
                                        </line>

                                        <line x1="3"
                                              y1="10"
                                              x2="21"
                                              y2="10">
                                        </line>

                                    </svg>
                                </span>

                                <input asp-for="TransactionDate"
                                       type="datetime-local"
                                       class="form-control purchase-input" />

                            </div>

                            <span asp-validation-for="TransactionDate"
                                  class="text-danger small">
                            </span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="Description"
                                   class="form-label purchase-label">
                                Descripción
                            </label>

                            <div class="purchase-input-wrapper">

                                <span class="purchase-input-icon">

                                    <svg xmlns="http://www.w3.org/2000/svg"
                                         width="18"
                                         height="18"
                                         viewBox="0 0 24 24"
                                         fill="none"
                                         stroke="currentColor"
                                         stroke-width="2"
                                         stroke-linecap="round"
                                         stroke-linejoin="round">

                                        <path d="M9 11l3 3L22 4"></path>
                                        <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>

                                    </svg>

                                </span>

                                <input asp-for="Description"
                                       class="form-control purchase-input"
                                       placeholder="Ej. Supermercado, farmacia, restaurante..." />

                            </div>

                            <span asp-validation-for="Description"
                                  class="text-danger small">
                            </span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="Amount"
                                   class="form-label purchase-label">
                                Monto
                            </label>

                            <div class="purchase-amount-wrapper">

                                <div class="purchase-currency">
                                    $
                                </div>

                                <input asp-for="Amount"
                                       type="number"
                                       step="0.01"
                                       min="0.01"
                                       class="form-control purchase-amount-input"
                                       placeholder="0.00" />

                                <div class="purchase-currency-code">
                                    USD
                                </div>

                            </div>

                            <span asp-validation-for="Amount"
                                  class="text-danger small">
                            </span>

                        </div>

                        <div class="purchase-actions">

                            <button type="submit"
                                    class="btn-purchase-primary">

                                <svg xmlns="http://www.w3.org/2000/svg"
                                     width="18"
                                     height="18"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2"
                                     stroke-linecap="round"
                                     stroke-linejoin="round">

                                    <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z">
                                    </path>

                                    <polyline points="17 21 17 13 7 13 7 21">
                                    </polyline>

                                </svg>

                                Registrar compra

                            </button>

                            <a asp-action="Statement"
                               asp-route-id="@Model.CreditCardId"
                               class="btn-purchase-secondary">

                                Cancelar

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

        <div class="col-lg-4">

            <div class="purchase-info-card">

                <div class="purchase-info-icon">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         width="24"
                         height="24"
                         viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2"
                         stroke-linecap="round"
                         stroke-linejoin="round">

                        <circle cx="12"
                                cy="12"
                                r="10">
                        </circle>

                        <line x1="12"
                              y1="16"
                              x2="12"
                              y2="12">
                        </line>

                        <line x1="12"
                              y1="8"
                              x2="12.01"
                              y2="8">
                        </line>

                    </svg>

                </div>

                <h5>
                    Información importante
                </h5>

                <p>
                    La compra será aplicada inmediatamente al saldo utilizado
                    de la tarjeta.
                </p>

                <div class="purchase-info-item">
                    <span class="purchase-info-check">✓</span>
                    El monto debe ser mayor que cero.
                </div>

                <div class="purchase-info-item">
                    <span class="purchase-info-check">✓</span>
                    La compra no puede superar el crédito disponible.
                </div>

                <div class="purchase-info-item">
                    <span class="purchase-info-check">✓</span>
                    El movimiento quedará registrado en el historial.
                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}