@model GestionTarjetaCredito.Mvc.Models.CreatePurchaseViewModel

@{
    ViewData["Title"] = "Registrar compra";
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="page-title">Registrar compra</h2>

        <p class="page-subtitle">
            Registra una nueva compra asociada a la tarjeta de crédito.
        </p>
    </div>

    <div class="row">

        <div class="col-lg-7">

            <div class="card financial-panel">

                <div class="card-body p-4">

                    <form asp-action="CreatePurchase"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input asp-for="CreditCardId"
                               type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="TransactionDate"
                                   class="form-label">
                            </label>

                            <input asp-for="TransactionDate"
                                   type="datetime-local"
                                   class="form-control" />

                            <span asp-validation-for="TransactionDate"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description"
                                   class="form-label">
                            </label>

                            <input asp-for="Description"
                                   class="form-control"
                                   placeholder="Ej. Supermercado, farmacia, restaurante..." />

                            <span asp-validation-for="Description"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Amount"
                                   class="form-label">
                            </label>

                            <div class="input-group">
                                <span class="input-group-text">$</span>

                                <input asp-for="Amount"
                                       type="number"
                                       step="0.01"
                                       min="0.01"
                                       class="form-control"
                                       placeholder="0.00" />
                            </div>

                            <span asp-validation-for="Amount"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-atlantida">
                                Registrar compra
                            </button>

                            <a asp-action="Statement"
                               asp-route-id="@Model.CreditCardId"
                               class="btn btn-outline-secondary">
                                Cancelar
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}